{
  "manifest_version": 3,
  "name": "Utility Lingua",
  "version": "0.2.0",
  "description": "Understand English as you read.",
  "permissions": [],
  "host_permissions": [
    "https://api.mymemory.translated.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["content.js", "quick-translate.js"],
      "run_at": "document_idle"
    }
  ]
}
