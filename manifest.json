{
  "manifest_version": 3,
  "name": "Utility Lingua",
  "version": "0.3.0",
  "description": "Translate words as you read.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.mymemory.translated.net/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["content.js", "quick-translate.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/lingua16.png",
    "32": "icons/lingua32.png",
    "48": "icons/lingua48.png",
    "128": "icons/lingua128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/lingua16.png",
      "32": "icons/lingua32.png",
      "48": "icons/lingua48.png",
      "128": "icons/lingua128.png"
    }
  }
}
